# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/insurance_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insurance_platform
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# ==============================================
# ENCRYPTION & SECURITY
# ==============================================
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your-session-secret-key
ENCRYPTION_KEY=your-32-character-encryption-key
HASH_ALGORITHM=sha256
SECURE_COOKIES=false

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=3001
HOST=localhost
API_BASE_URL=http://localhost:3001/api
API_VERSION=v1
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
API_KEY_RATE_LIMIT_PER_HOUR=1000
API_KEY_RATE_LIMIT_PER_DAY=10000

# ==============================================
# CORS & SECURITY HEADERS
# ==============================================
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-API-Key,X-Requested-With
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
CSP_ENABLED=false

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=Insurance Platform
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com
EMAIL_TEMPLATE_PATH=./templates

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications
PUSH_NOTIFICATION_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key

# ==============================================
# PAYMENT GATEWAY
# ==============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_WEBHOOK_ENDPOINT=/api/webhooks/stripe

# PayPal Configuration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ==============================================
# EXTERNAL API INTEGRATIONS
# ==============================================
KYC_API_KEY=your-kyc-api-key
KYC_API_URL=https://api.kyc-provider.com/v1
CREDIT_BUREAU_API_KEY=your-credit-bureau-api-key
CREDIT_BUREAU_API_URL=https://api.creditbureau.com/v1
TELEMATICS_API_KEY=your-telematics-api-key
FRAUD_DETECTION_API_KEY=your-fraud-detection-api-key

# Enterprise Integrations
EXPERIAN_API_KEY=your-experian-api-key
EXPERIAN_API_URL=https://api.experian.com/v1
USPS_API_KEY=your-usps-api-key
USPS_API_URL=https://secure.shippingapis.com
OPENWEATHER_API_KEY=your-openweather-api-key

# AI/ML Services
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
AI_RISK_API_KEY=your-ai-risk-api-key
AI_RISK_API_URL=https://api.airisk.com/v1

# ==============================================
# FILE STORAGE
# ==============================================
UPLOAD_PATH=./uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword
STORAGE_PROVIDER=local
STORAGE_CDN_URL=

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-insurance-documents-bucket
AWS_S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_BUCKET_NAME=your-bucket-name
GOOGLE_CLOUD_KEY_FILE=./config/gcp-service-account.json

# ==============================================
# CACHING CONFIGURATION
# ==============================================
ENABLE_CACHING=true
CACHE_TTL=3600
CACHE_PREFIX=insurance:
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=300
SESSION_STORE=redis

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_LOGGING=true

# Structured Logging
LOG_JSON_FORMAT=false
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_LEVEL=true
LOG_INCLUDE_PID=false

# ==============================================
# HEALTH CHECK & MONITORING
# ==============================================
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
SENTRY_DSN=your-sentry-dsn-for-error-tracking
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0

# Prometheus Metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PATH=/prometheus

# New Relic Monitoring
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
NEW_RELIC_APP_NAME=Insurance Platform

# ==============================================
# COMPLIANCE & AUDIT
# ==============================================
AUDIT_LOG_ENABLED=true
COMPLIANCE_LOGGING_ENABLED=true
DATA_RETENTION_DAYS=2555
GDPR_ENABLED=true
GDPR_DATA_RETENTION_DAYS=365
GDPR_RIGHT_TO_BE_FORGOTTEN_ENABLED=true
SOX_COMPLIANCE_ENABLED=true
HIPAA_COMPLIANCE_ENABLED=false

# Data Encryption at Rest
ENCRYPTION_AT_REST=true
ENCRYPTION_ALGORITHM=AES-256-GCM
KEY_ROTATION_DAYS=90

# ==============================================
# WEBHOOK CONFIGURATION
# ==============================================
WEBHOOK_SECRET=your-webhook-secret-key
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000

# Stripe Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_WEBHOOK_EVENTS=payment_intent.succeeded,payment_intent.payment_failed

# PayPal Webhooks
PAYPAL_WEBHOOK_SECRET=your-paypal-webhook-secret
PAYPAL_WEBHOOK_EVENTS=PAYMENT.CAPTURE.COMPLETED,PAYMENT.CAPTURE.DENIED

# ==============================================
# BACKGROUND JOBS
# ==============================================
JOB_QUEUE_ENABLED=true
JOB_QUEUE_REDIS_URL=redis://localhost:6379/1
JOB_CONCURRENCY=5
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=5000

# Job Types
BILLING_JOBS_ENABLED=true
COMPLIANCE_JOBS_ENABLED=true
AUDIT_JOBS_ENABLED=true
BACKUP_JOBS_ENABLED=true
NOTIFICATION_JOBS_ENABLED=true

# ==============================================
# ENTERPRISE FEATURES
# ==============================================
ENTERPRISE_MODE=false
ENTERPRISE_API_ENABLED=true
MULTI_TENANCY_ENABLED=true
WHITE_LABELING_ENABLED=true
CUSTOM_BRANDING_ENABLED=true

# Tenant Configuration
DEFAULT_TENANT_SLUG=default
TENANT_ISOLATION_ENABLED=true
CROSS_TENANT_ACCESS=false
TENANT_RESOURCE_LIMITS_ENABLED=true

# Subscription Management
SUBSCRIPTION_BILLING_ENABLED=true
SUBSCRIPTION_TRIALS_ENABLED=true
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_NOTIFICATION_DAYS=30

# ==============================================
# FEATURE FLAGS
# ==============================================
FEATURE_FRAUD_DETECTION=true
FEATURE_TELEMATICS=true
FEATURE_WORKFLOW_ENGINE=true
FEATURE_COMPLIANCE_ENGINE=true
FEATURE_REINSURANCE_ENGINE=true
FEATURE_RISK_SCORING=true
FEATURE_CRM=true
FEATURE_PARTNER_MARKETPLACE=true
FEATURE_APIS_SDKS=true
FEATURE_SECURITY=true
FEATURE_SANDBOX=true
FEATURE_TESTING=true
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_PREDICTIVE_ANALYTICS=true
FEATURE_REAL_TIME_PROCESSING=true

# ==============================================
# SSL CONFIGURATION (for production)
# ==============================================
SSL_CERT_PATH=/path/to/certificate.crt
SSL_KEY_PATH=/path/to/private.key
SSL_CA_PATH=/path/to/ca-bundle.crt
SSL_PROTOCOLS=TLSv1.2,TLSv1.3
SSL_CIPHERS=ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512

# ==============================================
# BACKUP & MAINTENANCE
# ==============================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.
MAINTENANCE_ALLOWED_IPS=

# Database Maintenance
DB_MAINTENANCE_ENABLED=true
DB_OPTIMIZATION_SCHEDULE=0 1 * * 0
DB_VACUUM_ENABLED=true
DB_ANALYZE_ENABLED=true