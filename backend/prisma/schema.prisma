generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// NEW: fixed set of roles (permissions for each role are dynamic, stored in DB)
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  AGENT
  POLICY_ADMINISTRATOR
  CLAIM_ASSESSOR
  CLAIM_SUPERVISOR
  CLAIM_MANAGER
  INSURER
  DEVELOPER
  SUPER_ADMIN

  @@map("user_role")
}

model Workspace {
  workspaceId String    @id @default(dbgenerated("gen_random_uuid()")) @map("workspace_id") @db.Uuid
  name        String    @db.VarChar(255)
  domain      String?   @db.VarChar(255)
  planType    String?   @default("starter") @map("plan_type") @db.VarChar(50)
  apiKey      String    @unique @map("api_key") @db.VarChar(255)
  apiSecret   String    @map("api_secret") @db.VarChar(255)
  status      String?   @default("active") @db.VarChar(50)
  settings    Json?     @default("{}")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // NEW back-relations
  rolePermissions  RolePermission[]
  roleClaimActions RoleClaimAction[]

  @@map("workspaces")
}

model User {
  userId       String    @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  workspaceId  String?   @map("workspace_id") @db.Uuid
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  role         UserRole  @default(AGENT) // CHANGED: was String @default("user")
  // REMOVED: permissions Json? @default("[]")  (rights now come from role_permissions)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  isActive     Boolean?  @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, email])
  @@index([workspaceId, role])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// NEW: dynamic permissions per workspace + role + feature
// One row per workspace + role + feature. No row = no access.
// ─────────────────────────────────────────────────────────────────────────────

model RolePermission {
  permissionId String    @id @default(dbgenerated("gen_random_uuid()")) @map("permission_id") @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  role         UserRole
  feature      String    @db.VarChar(100)
  canView      Boolean   @default(false) @map("can_view")
  canCreate    Boolean   @default(false) @map("can_create")
  canUpdate    Boolean   @default(false) @map("can_update")
  canDelete    Boolean   @default(false) @map("can_delete")
  updatedBy    String?   @map("updated_by") @db.Uuid
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)

  @@unique([workspaceId, role, feature])
  @@index([workspaceId, role])
  @@map("role_permissions")
}

// One row = this role may perform this claim action. No row = denied.
// claimType '*' = all claim types.
model RoleClaimAction {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  role        UserRole
  claimType   String    @default("*") @map("claim_type") @db.VarChar(100)
  action      String    @db.VarChar(50)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)

  @@unique([workspaceId, role, claimType, action])
  @@index([workspaceId, role])
  @@map("role_claim_actions")
}

// Per-user permission overrides. When set, these OVERRIDE the role-based matrix for this specific user.
// SuperAdmin can grant or restrict individual features per user, independent of their role.
model UserPermissionOverride {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  feature     String    @db.VarChar(100)
  canView     Boolean   @default(false) @map("can_view")
  canCreate   Boolean   @default(false) @map("can_create")
  canUpdate   Boolean   @default(false) @map("can_update")
  canDelete   Boolean   @default(false) @map("can_delete")
  updatedBy   String?   @map("updated_by") @db.Uuid
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, userId, feature])
  @@index([workspaceId, userId])
  @@map("user_permission_overrides")
}

